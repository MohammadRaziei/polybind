# Stub file for _my_module C extension.
# Simulates what nanobind/pybind11 stubgen would produce.

class _Box_int32:
    def __init__(self, val: int) -> None: ...
    def __add__(self, other: _Box_int32) -> _Box_int32: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: _Box_int32) -> bool: ...
    def value(self) -> int: ...

class _Box_float64:
    def __init__(self, val: float) -> None: ...
    def __mul__(self, other: _Box_float64) -> _Box_float64: ...
    def __repr__(self) -> str: ...
    def value(self) -> float: ...

class _Box_str_:
    def __init__(self, val: str) -> None: ...
    def __repr__(self) -> str: ...
    def __len__(self) -> int: ...
    def value(self) -> str: ...

class Renderer:
    """Non-template class — must be ignored by polybind."""
    def __init__(self) -> None: ...
    def render(self) -> None: ...
