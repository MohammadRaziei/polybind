"""Stub for _my_module — demonstrates single and multi-type templates."""

# single-type: Box<T>
class _Box__int32:
    """A box holding a 32-bit integer."""
    def __init__(self, val: int) -> None: ...
    def __add__(self, other: _Box__int32) -> _Box__int32: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: _Box__int32) -> bool: ...
    def value(self) -> int:
        """Return the stored integer value."""
        ...
    @staticmethod
    def zero() -> _Box__int32:
        """Return a _Box__int32 initialised to zero."""
        ...

class _Box__float64:
    """A box holding a 64-bit float."""
    def __init__(self, val: float) -> None: ...
    def __mul__(self, other: _Box__float64) -> _Box__float64: ...
    def __repr__(self) -> str: ...
    def value(self) -> float:
        """Return the stored float value."""
        ...
    @classmethod
    def from_string(cls, s: str) -> _Box__float64:
        """Parse a float from string."""
        ...

class _Box__str_:
    """A box holding a string."""
    def __init__(self, val: str) -> None: ...
    def __repr__(self) -> str: ...
    def __len__(self) -> int: ...
    def value(self) -> str:
        """Return the stored string value."""
        ...

# multi-type: Pair<T1, T2>
class _Pair__float64__int32:
    """A pair of (float64, int32) values."""
    def __init__(self, first: float, second: int) -> None: ...
    def __repr__(self) -> str: ...
    def first(self) -> float: ...
    def second(self) -> int: ...

class _Pair__int32__int64:
    """A pair of (int32, int64) values."""
    def __init__(self, first: int, second: int) -> None: ...
    def __repr__(self) -> str: ...
    def first(self) -> int: ...
    def second(self) -> int: ...

class Renderer:
    """Non-template class — must be ignored by polybind."""
    def __init__(self) -> None: ...
    def render(self) -> None: ...
